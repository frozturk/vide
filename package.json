{
  "name": "vide",
  "version": "0.2.1",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run build:litemux && electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run build:litemux && electron-vite build",
    "package": "npm run build:litemux && electron-vite build && electron-builder",
    "build:litemux": "cargo build --release --locked --manifest-path litemux/Cargo.toml",
    "test:litemux": "cargo test --release --locked --manifest-path litemux/Cargo.toml",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.vide.app",
    "productName": "Vide",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "skills/vide-browser/**/*",
      "scripts/browser.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "litemux/target/release",
        "to": ".",
        "filter": [
          "litemux",
          "litemux.exe"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "seti-icons": "^0.0.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@git-diff-view/react": "^0.1.6",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "zustand": "^5.0.0"
  }
}
